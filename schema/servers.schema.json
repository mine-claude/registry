{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mine-claude/registry/main/schema/servers.schema.json",
  "title": "MineClaude registry - servers.json",
  "description": "Servers the game lists as suggestions on the Multiplayer screen. Public metadata only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "servers"],
  "properties": {
    "version": { "const": 1 },
    "updated": { "type": "string", "format": "date" },
    "servers": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/server" }
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "address", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,31}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "address": {
          "description": "The server origin, no path. https only.",
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$",
          "maxLength": 200
        },
        "ws": {
          "description": "The game WebSocket endpoint. wss only; defaults to <address>/ws.",
          "type": "string",
          "pattern": "^wss://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~\\-/]*)?$",
          "maxLength": 200
        },
        "official": {
          "description": "true only for a server the owner runs.",
          "type": "boolean"
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 200 },
        "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+(-[0-9]+)?$" },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,23}$" }
        },
        "site": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~\\-/?=&%+]*)?$",
          "maxLength": 200
        }
      }
    }
  }
}
