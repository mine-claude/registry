{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mine-claude/registry/main/schema/relays.schema.json",
  "title": "MineClaude registry - relays.json",
  "description": "Relays the game may suggest for a browser-hosted world. Public metadata only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "relays"],
  "properties": {
    "version": { "const": 1 },
    "updated": { "type": "string", "format": "date" },
    "relays": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/relay" }
    }
  },
  "$defs": {
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "operator"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,31}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 48 },
        "url": {
          "description": "The relay WebSocket endpoint. wss only.",
          "type": "string",
          "pattern": "^wss://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~\\-/]*)?$",
          "maxLength": 200
        },
        "health": {
          "description": "HTTPS endpoint for the latency probe (/healthz). Defaults to the relay host over https.",
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~\\-/]*)?$",
          "maxLength": 200
        },
        "stats": {
          "description": "Optional HTTPS endpoint with the relay's live counters (/stats).",
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~\\-/]*)?$",
          "maxLength": 200
        },
        "region": {
          "description": "A country code (br) or a cloud-style region (sa-east, eu-west-1).",
          "type": "string",
          "pattern": "^[a-z]{2}(-[a-z]+)?(-[0-9]+)?$"
        },
        "status": {
          "description": "teste = a relay under trial, the game may warn; producao = ready for players.",
          "enum": ["teste", "producao"],
          "default": "teste"
        },
        "maxPlayersPerRoom": {
          "description": "How many players the relay accepts in one hosted world (its own limit).",
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "operator": { "type": "string", "minLength": 1, "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
